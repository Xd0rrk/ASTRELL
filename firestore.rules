rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- MEDIA ASSETS ---
    match /media_assets/{assetId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- SHOWCASE ITEMS (Landing Page 3D Gallery) ---
    match /showcase_items/{itemId} {
      allow read: if resource.data.is_active == true;
      allow write: if request.auth != null;
    }

    // --- GALLERY ITEMS (Portfolio) ---
    match /gallery_items/{itemId} {
      allow read: if resource.data.is_published == true;
      allow write: if request.auth != null;
    }

    // --- BLOG AUTHORS ---
    match /blog_authors/{authorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- BLOG POSTS ---
    match /blog_posts/{postId} {
      allow read: if resource.data.is_published == true;
      allow write: if request.auth != null;

      // --- BLOG SECTIONS (subcollection) ---
      match /sections/{sectionId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // --- COMPLIANCE LOGS (anonymous insert only) ---
    match /consent_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /agreement_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}